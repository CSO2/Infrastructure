# Copy this file to .env and fill in actual values
# .env is gitignored and will NOT be committed
#
# IMPORTANT: MongoDB and PostgreSQL passwords are NO LONGER stored here.
# They are managed by HashiCorp Vault.
# Run Infrastructure/cso2/scripts/vault-init.sh to seed passwords into Vault.
#
# These .env files are kept ONLY as bootstrap placeholders so Kustomize
# secretGenerator does not fail on first apply. After vault-init.sh runs,
# Vault becomes the source of truth for DB credentials.

# Placeholder values — real passwords are in Vault at:
#   secret/cso2/postgresql  (POSTGRES_USER, POSTGRES_PASSWORD, CSO2_USER, CSO2_PASSWORD)
#   secret/cso2/mongodb     (MONGO_INITDB_ROOT_USERNAME, MONGO_INITDB_ROOT_PASSWORD)
MONGODB_USERNAME=see-vault
MONGODB_PASSWORD=see-vault
POSTGRESQL_PASSWORD=see-vault

RABBITMQ_USERNAME=guest
RABBITMQ_PASSWORD=your-rabbitmq-password

# JWT RSA Keys (PEM format) — these stay here, not DB credentials
# Generate with: openssl genrsa -out jwt-private.pem 4096 && openssl rsa -in jwt-private.pem -pubout -out jwt-public.pem
JWT_PRIVATE_KEY=-----BEGIN RSA PRIVATE KEY-----\nYOUR_PRIVATE_KEY_HERE\n-----END RSA PRIVATE KEY-----
JWT_PUBLIC_KEY=-----BEGIN PUBLIC KEY-----\nYOUR_PUBLIC_KEY_HERE\n-----END PUBLIC KEY-----
