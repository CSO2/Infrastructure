ui = true
disable_mlock = true
cluster_name = "{{ vault_cluster_name }}"
api_addr = "{{ vault_api_addr }}"
cluster_addr = "{{ vault_cluster_addr }}"

storage "raft" {
  path    = "{{ vault_data_dir }}"
  node_id = "{{ vault_raft_node_id }}"
}

listener "tcp" {
  address         = "0.0.0.0:8200"
  cluster_address = "0.0.0.0:8201"
  tls_disable     = {{ 1 if vault_tls_disable else 0 }}
}

{% if vault_kms_key_id %}
seal "awskms" {
  region    = "{{ vault_kms_region }}"
  kms_key_id = "{{ vault_kms_key_id }}"
}
{% endif %}

service_registration "aws" {}
