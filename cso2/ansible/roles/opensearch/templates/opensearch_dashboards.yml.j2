# OpenSearch Dashboards Configuration
# {{ ansible_managed }}

# Server options
server.port: {{ opensearch_dashboards_port }}
server.host: "{{ opensearch_dashboards_host }}"
server.name: "opensearch-dashboards"

# OpenSearch connection
opensearch.hosts: 
{% for host in groups['opensearch'] %}
  - https://{{ hostvars[host]['ansible_host'] }}:{{ opensearch_http_port }}
{% endfor %}

opensearch.ssl.verificationMode: none
opensearch.username: admin
opensearch.password: {{ opensearch_admin_password }}

# Request timeouts
opensearch.requestTimeout: 30000
opensearch.shardTimeout: 30000

# Logging
logging.dest: {{ opensearch_log_dir }}/opensearch-dashboards.log
logging.verbose: false

# Security settings
opensearch_security.multitenancy.enabled: true
opensearch_security.multitenancy.tenants.preferred: ["Private", "Global"]
opensearch_security.readonly_mode.roles: ["kibana_read_only"]
opensearch_security.cookie.secure: false

# Map settings
map.includeElasticMapsService: false

# Saved objects
savedObjects.maxImportExportSize: 10000
savedObjects.maxImportPayloadBytes: 26214400

# UI settings
newsfeed.enabled: false
telemetry.enabled: false
